{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug (MinGW-w64 GDB)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/xiangmuyi.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "D:/MinGW-w64/mingw64/bin/gdb.exe",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "CMake: Build"
        }
    ]
}
