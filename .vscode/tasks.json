{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake: Configure",
            "type": "shell",
            "command": "D:/MinGW-w64/mingw64/bin/cmake.exe",
            "args": [
                "-S",
                "${workspaceFolder}",
                "-B",
                "${workspaceFolder}/build",
                "-G",
                "MinGW Makefiles",
                "-DCMAKE_C_COMPILER=D:/MinGW-w64/mingw64/bin/gcc.exe",
                "-DCMAKE_CXX_COMPILER=D:/MinGW-w64/mingw64/bin/g++.exe",
                "-DCMAKE_MAKE_PROGRAM=D:/MinGW-w64/mingw64/bin/mingw32-make.exe"
            ],
            "problemMatcher": []
        },
        {
            "label": "CMake: Build",
            "type": "shell",
            "command": "D:/MinGW-w64/mingw64/bin/cmake.exe",
            "args": [
                "--build",
                "${workspaceFolder}/build"
            ],
            "dependsOn": "CMake: Configure",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$gcc"
        }
    ]
}
